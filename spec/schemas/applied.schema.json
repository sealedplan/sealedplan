{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sealedplan/sealedplan/blob/main/spec/schemas/applied.schema.json",
  "title": "sealedplan v0.1 Applied",
  "description": "SPEC §5.4.",
  "type": "object",
  "required": [
    "spec_version",
    "applied_id",
    "plan_hash",
    "approval_ids",
    "outcome",
    "started_at",
    "finished_at",
    "principal"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/spec_version" },
    "applied_id": { "type": "string" },
    "plan_hash": { "$ref": "common.schema.json#/$defs/digest" },
    "approval_ids": { "type": "array", "items": { "type": "string" } },
    "outcome": { "enum": ["succeeded", "failed", "unknown"] },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "finished_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "principal": { "$ref": "common.schema.json#/$defs/principal" },
    "observed": {
      "description": "Post-apply observation per resource id (§8.5, §9.3).",
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/object" }
    },
    "result": { "$ref": "common.schema.json#/$defs/value" },
    "compensation_handle": { "$ref": "common.schema.json#/$defs/value" },
    "error": { "type": "string" }
  }
}
